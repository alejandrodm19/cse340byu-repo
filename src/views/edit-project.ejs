<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
        
        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= projectDetails.title %>"
                required
                maxlength="50"
            />
        </div>

        <div class="form-group">
            <label for="organizationId">Managing Organization</label>
            <select id="organizationId" name="organizationId" required>
                <option value="">-- Select an Organization --</option>
                <% organizations.forEach(org => { %>
                    <option 
                        value="<%= org.organization_id %>"
                        <%= org.organization_id === projectDetails.organization_id ? 'selected' : '' %>
                    >
                        <%= org.name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                required
                maxlength="500"
            ><%= projectDetails.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= projectDetails.location %>"
                required
                maxlength="50"
            />
        </div>

        <div class="form-group">
            <label for="date">Project Date</label>
            <% 
                // Formateamos la fecha a YYYY-MM-DD requerido por HTML5 inputs
                const rawDate = new Date(projectDetails.date);
                const isoDate = rawDate.toISOString().split('T')[0];
            %>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= isoDate %>"
                required
            />
        </div>

        <button type="submit">Update Project</button>
    </form>
</main>
<%- include('partials/footer') %>