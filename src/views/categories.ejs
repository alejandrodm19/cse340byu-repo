<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Available Categories</h2>
    
    <ul>
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <strong><%= category.name %></strong>
                    </a>
                </li>
            <% }); %>
        <% } else { %>
            <li>No categories found in the database.</li>
        <% } %>
    </ul>
    <a href="/new-category" class="btn-action" style="display: inline-block; margin-bottom: 15px; padding: 8px 12px; background: #28a745; color: white; text-decoration: none; border-radius: 4px;">
    + Add New Category
    </a>
</main>
<%- include('partials/footer') %>