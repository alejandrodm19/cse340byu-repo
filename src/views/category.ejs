<%- include('partials/header') %>
<main>
    <h1><%= category.name %></h1>
    <p>All service projects under this category:</p>

    <ul>
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <strong><%= project.title %></strong>
                    </a>
                    <p><%= project.description %></p>
                    <small>📍 Location: <%= project.location %></small>
                </li>
            <% }); %>
        <% } else { %>
            <li>No projects found for this category at the moment.</li>
        <% } %>
    </ul>
    <a href="/edit-category/<%= category.category_id %>" class="btn-action" style="display: inline-block; margin-top: 15px; padding: 6px 12px; background: #007bff; color: white; text-decoration: none; border-radius: 4px;">
    Edit This Category
    </a>
</main>
<%- include('partials/footer') %>