<%- include('partials/header') %>
<main class="admin-container">
    <h1><%= title %></h1>
    <p>All registered users in the system and their security clearance level.</p>

    <table class="user-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email (Username)</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><%= user.user_id %></td>
                    <td><strong><%= user.name %></strong></td>
                    <td><%= user.email %></td>
                    <td><span class="role-badge <%= user.role_name %>"><%= user.role_name %></span></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</main>
<%- include('partials/footer') %>