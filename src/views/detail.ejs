<% if (locals.isLoggedIn) { %>
    <div class="volunteer-panel">
        <% if (isVolunteering) { %>
            <p class="status-msg">✓ You are volunteering for this project!</p>
            <form action="/volunteer/remove" method="POST">
                <input type="hidden" name="project_id" value="<%= project.project_id %>">
                <input type="hidden" name="redirect_to" value="/projects/detail/<%= project.project_id %>">
                <button type="submit" class="btn btn-danger">Cancel Volunteering</button>
            </form>
        <% } else { %>
            <form action="/volunteer/add" method="POST">
                <input type="hidden" name="project_id" value="<%= project.project_id %>">
                <button type="submit" class="btn btn-primary">Volunteer for this Project</button>
            </form>
        <% } %>
    </div>
<% } else { %>
    <p class="login-notice"><a href="/login">Log in</a> to volunteer for this project.</p>
<% } %>